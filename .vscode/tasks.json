{
    // See https://go.microsoft
    // .com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DB",
            "type": "shell",
            "command": "nix-shell --run \"(pg_ctl -D .pgdata stop -m fast || true) && rm -rf .pgdata/postmaster.pid && pg_ctl -D .pgdata -l logfile -w start && trap 'pg_ctl -D .pgdata stop -m fast' EXIT && psql -d co_driver_db\"",
            "icon": {
                "id": "database",
                "color": "terminal.ansiRed"
            },
            "presentation": {
                "echo": false,
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false,
                "close": false,
                "revealProblems": "onProblem"
            },
        },
        {
            "label": "backend",
            "type": "shell",
            "command": "nix-shell --run 'cd backend && npx nodemon index.js'",
            "icon": {
                "id": "plug",
                "color": "terminal.ansiGreen"
            },
            "presentation": {
                "echo": false,
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false,
            }
        },
        {
            "label": "frontend",
            "type": "shell",
            "command": "nix-shell --run 'cd frontend && npx expo start --localhost -c'",
            "icon": {
                "id": "device-mobile",
                "color": "terminal.ansiCyan"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false,
                "group": "frontend"
            },
            "problemMatcher": [
                "$tsc",
                "$tsc-watch",
                "$eslint-stylish"
            ]
        },
        {
            "label": "ADB",
            "type": "shell",
            "command": "nix-shell --run 'adb reverse tcp:5000 tcp:5000 && adb reverse tcp:8081 tcp:8081'",
            "icon": {
                "id": "debug-connected",
                "color": "terminal.ansiCyan"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "close": true,
            }
        },
        {
            "label": "front term",
            "type": "shell",
            "command": "nix-shell --run 'cd frontend'",
            "icon": {
                "id": "fold-horizontal",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false,
                "group": "frontend"
            }
        },
        {
            "label": "Start Project",
            "type": "shell",
            "dependsOn":[
                "DB",
                "backend",
                "frontend",
                "front term"
            ],
            "dependsOrder": "parallel",
            "runOptions": {
                "runOn": "folderOpen"
            },
        }
    ]
}