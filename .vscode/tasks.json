{
  "version": "2.0.0",
  // See https://go.microsoft
  // .com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "tasks": [
    {
      "label": "DB",
      "type": "shell",
      "icon": {
        "id": "database",
        "color": "terminal.ansiRed"
      },
      "command": "cd backend && direnv exec . bash -c \"(pg_ctl -D .pgdata stop -m fast || true) && rm -rf .pgdata/postmaster.pid && pg_ctl -D .pgdata -l logfile -w start && trap 'pg_ctl -D .pgdata stop -m fast' EXIT && psql -d co_driver_db\"",
      "presentation": {
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false,
        "close": false,
        "revealProblems": "onProblem",
        "group": "termina"
      }
    },
    {
      "label": "backend",
      "type": "shell",
      "icon": {
        "id": "plug",
        "color": "terminal.ansiGreen"
      },
      "command": "cd backend && direnv exec . npx nodemon index.js",
      "presentation": {
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false,
        "group": "environment"
      }
    },
    {
      "label": "frontend",
      "type": "shell",
      "icon": {
        "id": "device-mobile",
        "color": "terminal.ansiCyan"
      },
      "command": "cd frontend && direnv exec . bunx expo start --localhost -c",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false,
        "group": "environment"
      },
    },
    {
      "label": "Start Whole Project",
      "type": "shell",
      "dependsOn": ["DB", "backend", "frontend"],
      "dependsOrder": "parallel",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
