{
    // See https://go.microsoft
    // .com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DB",
            "type": "shell",
            "command": "nix-shell --run \"(pg_ctl -D .pgdata stop -m fast || true) && rm -rf .pgdata/postmaster.pid && pg_ctl -D .pgdata -l logfile -w start && trap 'pg_ctl -D .pgdata stop -m fast' EXIT && psql -d co_driver_db\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "icon": {
                "id": "database",
                "color": "terminal.ansiRed"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "echo": false,
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false,
                "close": false,
                "revealProblems": "onProblem"
            },
        },
        {
            "label": "backend",
            "type": "shell",
            "command": "nix-shell --run 'cd backend && node index.js'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "icon": {
                "id": "plug",
                "color": "terminal.ansiGreen"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "echo": false,
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false,
                "group": "servers"
            }
        },
        {
            "label": "frontend",
            "type": "shell",
            "command": "nix-shell --run 'cd frontend && npx expo start'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "icon": {
                "id": "device-mobile",
                "color": "terminal.ansiCyan"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false,
                "group": "servers"
            }
        }
    ]
}